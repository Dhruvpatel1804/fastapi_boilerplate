ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL must run on your local machine or a remote server (not in Docker).
# Local example:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
# Remote server example:
# DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/app_db
# When running the API container against a DB on the host machine:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/app_db

CORS_ORIGINS=["http://localhost:3000"]
